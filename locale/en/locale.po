msgid "plugins.generic.OASwitchboard.displayName"
msgstr "OA Switchboard Plugin"

msgid "plugins.generic.OASwitchboard.settings.apiKeySecretMissing"
msgstr "Your OJS is missing a security setting ('api_key_secret'). You may contact your system administrator to set it up in the config file."

msgid "plugins.generic.OASwitchboard.settings.apiKeySecretInfomration"
msgstr ""
"The 'api_key_secret' is use to safely store your OA Switchboard credentials.<br>More information on how to set it up can be found in <a href=\"https://forum.pkp.sfu.ca/t/how-to-generate-a-api-key-secret-code-in-ojs-3/72008/\" target=\"_blank\">this PKP Community Forum thread</a>."
"<br><br>Once it's set up, come back here to enter your credentials."

msgid "plugins.generic.OASwitchboard.settings.issnMissing"
msgstr "Until an ISSN or eISSN is assigned to the journal, the OA Switchboard plugin will not be able to send messages."

msgid "plugins.generic.OASwitchboard.description"
msgstr "Allows sending messages to OA Switchboard, automatically, at the publication of an article."

msgid "plugins.generic.OASwitchboard.settings.description"
msgstr "Please, enter your Open Access Switchboard credentials below, to allow the plugin to access the API."

msgid "plugins.generic.OASwitchboard.settings.description.hasCredentials"
msgstr "The API credentials are ready to use! Currently using credentials for: <strong>{$username}</strong>."
"<br>You can edit the credentials below, or click the Cancel button."

msgid "plugins.generic.OASwitchboard.settings.username"
msgstr "Username:"

msgid "plugins.generic.OASwitchboard.settings.password"
msgstr "Password:"

msgid "plugins.generic.OASwitchboard.settings.apiAuthenticatorFailed"
msgstr "Authentication failed, please check the OA Switchboard API credentials."

msgid "plugins.generic.OASwitchboard.pluginIsNotConfigured"
msgstr "The OA Switchboard plugin is not configured."

msgid "plugins.generic.OASwitchboard.sendMessageWithSuccess"
msgstr "The P1 message was successfully sent to the OA Switchboard."

msgid "plugins.generic.OASwitchboard.sendMessageWithError"
msgstr "The P1 message could not be sent to the OA Switchboard."

msgid "plugins.generic.OASwitchboard.postRequirements"
msgstr "Error while attempting to send message via OA Switchboard API. More information can be found in the server logs."

msgid "plugins.generic.OASwitchboard.serverError"
msgstr "Error sending the message. The OA Switchboard API returned an internal server error."

msgid "plugins.generic.OASwitchboard.connectionError"
msgstr "Could not connect to OA Switchboard. Please try again later."

msgid "plugins.generic.OASwitchboard.unconfirmedDelivery"
msgstr "The connection to OA Switchboard was interrupted after the message was sent, so it is not known whether it arrived. Check with OA Switchboard before trying again."

msgid "plugins.generic.OASwitchboard.rorRecommendation"
msgstr "It is recommended that at least one author has a ROR ID linked to their affiliation to send the message to the author's institution."

msgid "plugins.generic.OASwitchboard.postRequirementsError"
msgstr "The submission does not meet the minimum requirements to send the P1 message to the OA Switchboard."

msgid "plugins.generic.OASwitchboard.postRequirementsError.introductionText"
msgstr "it will not be possible to send the P1 message as the submission does not meet the following requirements."

msgid "plugins.generic.OASwitchboard.postRequirementsError.familyName"
msgstr "The family name of all authors must be present."

msgid "plugins.generic.OASwitchboard.postRequirementsError.affiliation"
msgstr "All authors must have their affiliation filled in."

msgid "plugins.generic.OASwitchboard.postRequirementsError.doi"
msgstr "The article must have an associated DOI."

msgid "plugins.generic.OASwitchboard.postRequirementsError.issn"
msgstr "The journal must have an assigned ISSN."

msgid "plugins.generic.OASwitchboard.postRequirementsError.unchecked"
msgstr "The requirements could not be checked because of an unexpected error. The details are in the server error log."

msgid "plugins.generic.OASwitchboard.postRequirementsError.conclusionText"
msgstr "You may review these metadata, or proceed with the publication without sending the message to the OA Switchboard."

msgid "plugins.generic.OASwitchboard.postRequirementsSuccess"
msgstr "the requirements have been met and the P1 message will be sent to the OA Switchboard upon publishing the submission."

msgid "plugins.generic.OASwitchboard.includePrefix"
msgstr "OA Switchboard: "

msgid "plugins.generic.OASwitchboard.workflowTab.label"
msgstr "OA Switchboard"

msgid "plugins.generic.OASwitchboard.workflowTab.title"
msgstr "Status of message sent to OA Switchboard"

msgid "plugins.generic.OASwitchboard.sendScheduled"
msgstr "The P1 message was scheduled to be sent to the OA Switchboard."

msgid "plugins.generic.OASwitchboard.sendStatus.pending"
msgstr "The P1 message is queued to be sent to the OA Switchboard."

msgid "plugins.generic.OASwitchboard.sendStatus.notSent"
msgstr "The P1 message was not sent to the OA Switchboard because the submission does not meet the minimum requirements."

msgid "plugins.generic.OASwitchboard.sendStatus.lastUpdate"
msgstr "Last update: {$date}"

msgid "plugins.generic.OASwitchboard.sendStatus.retry"
msgstr "Try again"

msgid "plugins.generic.OASwitchboard.sendStatus.neverSent"
msgstr "This article was published without a message being sent to the OA Switchboard."

msgid "plugins.generic.OASwitchboard.sendStatus.sendNow"
msgstr "Send now"

msgid "plugins.generic.OASwitchboard.sendStatus.publishedBeforePlugin"
msgstr "This article was published before the OA Switchboard plugin was installed, so no message was sent."

msgid "plugins.generic.OASwitchboard.sendStatus.sendNowConfirm"
msgstr "A P1 message about this article will be sent to the OA Switchboard now."

msgid "plugins.generic.OASwitchboard.sendStatus.pluginDisabled"
msgstr "The OA Switchboard plugin is disabled for this journal, so the message was not sent."

msgid "plugins.generic.OASwitchboard.resend.notPublished"
msgstr "The P1 message can only be sent for a published submission."

msgid "plugins.generic.OASwitchboard.resend.notFailed"
msgstr "The P1 message can only be sent when it was not sent yet, after a failed send, or when a send has been waiting for more than an hour."
